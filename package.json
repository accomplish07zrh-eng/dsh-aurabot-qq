{
  "name": "dsh-aurabot-qq",
  "version": "1.3.0-beta.1",
  "description": "Aurabot：住在 QQ 里的 AI 伙伴「大肥鱼」—— DeepSeek Harness 插件（经 SnowLuma / OneBot v11 接 QQ）",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "src/host.js",
  "exports": {
    ".": "./src/host.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "qq",
    "onebot"
  ],
  "files": [
    "src",
    "client",
    "models",
    "personas",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "docs/USER-MANUAL.md",
    "docs/MODULE-TUTORIAL.md",
    "docs/EMBEDDING.md",
    "docs/SILICONFLOW.md",
    "LICENSE",
    "CHANGELOG.md",
    "README_EN.md",
    "docs/DESIGN.md"
  ],
  "optionalDependencies": {
    "onnxruntime-node": "^1.20.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aureth-labs/dsh-aurabot-qq.git"
  },
  "homepage": "https://github.com/aureth-labs/dsh-aurabot-qq",
  "engines": {
    "node": ">=22.13.0"
  }
}
